configuration {
    show-icons: true;
    drun-display-format: "{name}";
    disable-history: false;
}

* {
    bg:          #11151b;
    surface:     #191f28;
    surface-alt: #222b36;
    fg:          #e5ebf2;
    muted:       #8493a5;
    accent:      #8bbbd8;
    border:      #354353;

    background-color: transparent;
    text-color: @fg;
    font: "Inter 11";
}

window {
    width: 600px;
    border: 1px;
    border-color: @border;
    border-radius: 16px;
    background-color: @bg;
    padding: 22px;
}

mainbox {
    background-color: transparent;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: @border;
    border-radius: 10px;
    padding: 13px 16px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;
}

listview {
    columns: 1;
    lines: 6;
    fixed-height: true;
    scrollbar: false;
    spacing: 5px;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 8px;
    background-color: transparent;
}

element normal.normal {
    text-color: @fg;
}

element selected.normal {
    background-color: @surface-alt;
    text-color: @accent;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
}
